async function startInstance(name, token, phoneNumber = null) {
  fs.mkdirSync(instanceDir(name), { recursive: true });

  const { state, saveCreds } = await useMultiFileAuthState(instanceDir(name));
  const { version } = await fetchLatestBaileysVersion();

  const data = {
    instance: name,
    token,
    sock: null,
    qr: null,
    pairingCode: null,
    status: 'connecting',
    phone: null,
    displayName: null,
    lastUpdate: new Date().toISOString(),
  };

  const sock = makeWASocket({
    version,
    auth: state,
    logger: pino({ level: 'silent' }),
    browser: ['Ubuntu', 'Chrome', '20.0.04'],
    markOnlineOnConnect: true,
    syncFullHistory: false,
  });

  data.sock = sock;
  instances.set(name, data);

  sock.ev.on('creds.update', saveCreds);

  // --- LÓGICA DE INTELIGÊNCIA ARTIFICIAL (BOT NATIVO) ---

sock.ev.on('messages.upsert', async (m) => {

      // 🔍 DEBUG TOTAL
      console.log('🔍 [RAW] messages.upsert tipo:', m.type, 'qtd:', m.messages?.length || 0);
      if (m.messages && m.messages[0]) {
        const mm = m.messages[0];
        console.log('🔍 [RAW] fromMe:', mm.key?.fromMe, 'remoteJid:', mm.key?.remoteJid);
        console.log('🔍 [RAW] keys do message:', Object.keys(mm.message || {}).join(', '));
        if (mm.message) {
          console.log('🔍 [RAW] message completo:', JSON.stringify(mm.message).substring(0, 500));
        }
      }


      // ✅ FIX TDZ v2: promptAgente declarado no topo do handler
      const promptAgente = getPromptAgente(name);
    if (m.type !== 'notify') return;
    for (const msg of m.messages) {
      // ✅ Permitir fromMe:true SE for clique em botão/lista (interactiveResponseMessage)
      const temInteractive = msg.message && (
        msg.message.interactiveResponseMessage ||
        msg.message.buttonsResponseMessage ||
        msg.message.templateButtonReplyMessage ||
        msg.message.listResponseMessage
      );
      if (!msg.message) continue;
      if (msg.key.fromMe && !temInteractive) continue;

      const remoteJid = msg.key.remoteJid;
      if (remoteJid.includes('@g.us')) continue;

      // ============================================================
      // 1. DETECTAR TEXTO OU CLIQUE
      // ============================================================
      let textMessage = '';
      let isButtonClick = false;
      let buttonId = '';

      // 🔍 DEBUG temporário
      console.log(`🔍 [DEBUG] keys:`, Object.keys(msg.message || {}).join(', '));

      if (msg.message.buttonsResponseMessage) {
        buttonId = msg.message.buttonsResponseMessage.selectedButtonId;
        textMessage = buttonId;
        isButtonClick = true;
        console.log(`🔍 [DEBUG] buttonsResponse -> ${buttonId}`);
      } else if (msg.message.templateButtonReplyMessage) {
        buttonId = msg.message.templateButtonReplyMessage.selectedId;
        textMessage = buttonId;
        isButtonClick = true;
        console.log(`🔍 [DEBUG] templateButton -> ${buttonId}`);
      } else if (msg.message.listResponseMessage) {
        buttonId = msg.message.listResponseMessage.singleSelectReply?.selectedRowId;
        textMessage = buttonId;
        isButtonClick = true;
        console.log(`🔍 [DEBUG] listResponse -> ${buttonId}`);
      } else if (msg.message.interactiveResponseMessage) {
        // ✅ NOVO: respostas de lista nativa via @qadeerxtech/qadeer-btns
        try {
          const ir = msg.message.interactiveResponseMessage;
          console.log(`🔍 [DEBUG] interactiveResponse raw:`, JSON.stringify(ir).substring(0, 500));
          let params = ir.nativeFlowResponseMessage?.paramsJson;
          if (typeof params === 'string') {
            try { params = JSON.parse(params); } catch(e) {}
          }
          buttonId = (params && (params.id || params.selectedId || params.selectedRowId)) || ir.nativeFlowResponseMessage?.name || '';
          textMessage = buttonId;
          isButtonClick = true;
          console.log(`🔍 [DEBUG] interactiveResponse -> ${buttonId}`);
        } catch (e) {
          console.error('Erro parse interactiveResponseMessage:', e.message);
        }
      } else {
        textMessage = msg.message.conversation ||
                      msg.message.extendedTextMessage?.text ||
                      msg.message.imageMessage?.caption || '';
      }

      if (!textMessage) continue;

      console.log(`📩 [${name}] Mensagem: "${textMessage.substring(0, 50)}" (botão: ${isButtonClick})`);

      // ============================================================
      // SISTEMA DE RECADOS (Assistente Pessoal)
      // ============================================================
      const estadoRecado = estadosRecado.get(remoteJid);
      
      if (estadoRecado) {
        const textoLower = textMessage.toLowerCase().trim();
        
        // Cancelar
        if (textoLower === 'cancelar' || textoLower === 'sair') {
          estadosRecado.delete(remoteJid);
          await sock.sendMessage(remoteJid, { 
            text: '❌ Operacao cancelada. Se precisar, e so chamar!'
          });
          continue;
        }
        
        // Fluxo de recado em andamento
        if (estadoRecado.step === 'nome') {
          estadoRecado.nome = textMessage.trim();
          estadoRecado.step = 'recado';
          estadosRecado.set(remoteJid, estadoRecado);
          
          await sock.sendMessage(remoteJid, { 
            text: '📝 Prazer, *' + estadoRecado.nome + '*!\n\nAgora me conta o recado que voce quer deixar:\n\n_(ou digite "cancelar" para sair)_'
          });
          continue;
        }
        
        if (estadoRecado.step === 'recado') {
          estadoRecado.recado = textMessage.trim();
          estadoRecado.step = 'confirmar';
          estadosRecado.set(remoteJid, estadoRecado);
          
          const preview = '📋 *Confirme o recado:*\n\n' +
            '👤 *Nome:* ' + estadoRecado.nome + '\n' +
            '💬 *Recado:* ' + estadoRecado.recado + '\n\n' +
            'Esta correto?';
          
          try {
            await sendButtons(sock, remoteJid, {
              title: '✅ Confirmar Recado',
              text: preview,
              footer: 'Assistente Pessoal',
              buttons: [
                { id: 'confirmar_recado', text: '✅ Confirmar' },
                { id: 'cancelar_recado', text: '❌ Cancelar' }
              ]
            });
          } catch (e) {
            await sock.sendMessage(remoteJid, { text: preview + '\n\nDigite *SIM* para confirmar ou *NAO* para cancelar.' });
          }
          continue;
        }
        
        if (estadoRecado.step === 'confirmar') {
          const confirmou = textoLower === 'sim' || textoLower === 's' || textoLower === '✅' || 
                           (isButtonClick && buttonId === 'confirmar_recado');
          const cancelou = textoLower === 'nao' || textoLower === 'não' || textoLower === 'n' || 
                          (isButtonClick && buttonId === 'cancelar_recado');
          
          if (confirmou) {
            // Salvar recado
            const recado = {
              id: Date.now(),
              instance: name,
              remoteJid: remoteJid,
              nome: estadoRecado.nome,
              recado: estadoRecado.recado,
              data: new Date().toISOString()
            };
            
            saveRecado(recado);
            estadosRecado.delete(remoteJid);
            
            console.log('📝 Recado salvo: ' + recado.nome + ' - ' + recado.recado.substring(0, 50));
            
            await sock.sendMessage(remoteJid, { 
              text: '✅ *Recado salvo com sucesso!*\n\n' +
                    'Obrigado, *' + recado.nome + '*! \n\n' +
                    'Assim que possivel, vou ler sua mensagem e te responder. \n\n' +
                    '💚 Obrigado pela preferencia!'
            });
            continue;
          }
          
          if (cancelou) {
            estadosRecado.delete(remoteJid);
            await sock.sendMessage(remoteJid, { 
              text: '❌ Recado cancelado. Se precisar, e so chamar!'
            });
            continue;
          }
          
          // Se não confirmou nem cancelou, mostra novamente
          await sock.sendMessage(remoteJid, { 
            text: 'Por favor, responda *SIM* para confirmar ou *NAO* para cancelar.'
          });
          continue;
        }
      }
      
      // ✅ DETECTAR PEDIDO DE OPT-OUT (SAIR/PARAR/STOP)
      const textoOptout = textMessage.toLowerCase().trim();
      const ehOptout = ['sair', 'parar', 'stop', 'cancelar', 'remover', 'descadastrar'].some(p => textoOptout === p || textoOptout.startsWith(p + ' '));
      if (ehOptout) {
        const telefoneCliente = remoteJid.replace(/@.*$/, '');
        registrarOptout(telefoneCliente, 'resposta_sair');
        try {
          await sock.sendMessage(remoteJid, {
            text: '✅ Pronto! Você não receberá mais mensagens nossas.\n\nSe mudar de ideia, é só nos chamar de novo. 🙏'
          });
        } catch (e) {}
        console.log(`🚫 Opt-out via mensagem: ${telefoneCliente}`);
        continue;
      }

      // ✅ DETECTAR AUTORIZAÇÃO (opt-in manual)
      const textoOptin = textMessage.toLowerCase().trim();
      if (textoOptin === 'autorizo' || textoOptin === 'sim autorizo' || buttonId === 'autorizo') {
        const telefoneCliente = remoteJid.replace(/@.*$/, '');
        registrarOptin(telefoneCliente, name, 'botao_autorizo');
        console.log(`✅ Opt-in registrado via botão: ${telefoneCliente}`);
      }

      // ✅ DETECTAR CONSULTA DE STATUS
      // Caso 1: "PED-XXXX" (específico)
      // Caso 2: "status", "meus pedidos", "meu pedido" (lista abertos)
      // Caso 3: botão "status_pedido" (lista abertos)
      const ehConsultaStatus = (
        /PED[-\s]?\d{1,6}/i.test(textMessage) ||
        /^(status|meus?\s*pedidos?|acompanhar|onde\s*est[áa]|rastrear)$/i.test(textMessage.trim()) ||
        (isButtonClick && buttonId === 'status_pedido')
      );

      if (ehConsultaStatus) {
        const respStatus = await consultarStatusPedido(name, remoteJid, textMessage);
        if (respStatus) {
          await sock.sendMessage(remoteJid, { text: respStatus });
          console.log(`📦 [${name}] Consulta de status respondida`);
          continue;
        }
      }

      // Detectar comando para iniciar o fluxo de recado
      const textoLowerGlobal = textMessage.toLowerCase().trim();
      const ehComandoRecado = textoLowerGlobal === 'recado' || 
                              textoLowerGlobal === 'deixar recado' || 
                              textoLowerGlobal === 'recados' ||
                              (isButtonClick && buttonId === 'deixar_recado');
      
      if (ehComandoRecado) {
        estadosRecado.set(remoteJid, { step: 'nome', nome: null, recado: null, instance: name });
        
        await sock.sendMessage(remoteJid, {
          text: '📝 *Deixar Recado*\n\n' +
                'Otimo! Vou anotar seu recado para que eu possa ver depois. \n\n' +
                '*Qual e o seu nome?*\n\n' +
                '_(ou digite "cancelar" para sair)_'
        });
        continue;
      }

      // ============================================================
      // 2. FLUXO FIXO — PRIORIDADE MÁXIMA
      // ============================================================
      const fluxoCfg = fluxoConfigs.get(name);
      if (fluxoCfg && fluxoCfg.enabled) {
        const flow = carregarFluxo(fluxoCfg.flow || 'padrao');
        
        if (flow) {
          const textoLower = textMessage.toLowerCase().trim();
          const ehSaudacao = !isButtonClick && /^(oi|ola|ol[aá]|bom dia|boa tarde|boa noite|eai|e ai|opa|hey|hi|hello|menu|op[cç][oõ]es|iniciar|start|voltar|tudo bem|tudo bom|td bem|td bom|blz|beleza)[\s!.,?]*/i.test(textoLower);
          
          let proximoNo = null;


          if (ehSaudacao && !promptAgente) {
            proximoNo = 'inicio';
          } else if (isButtonClick) {

            const estado = getFluxoEstado(remoteJid);
            const noAtual = estado ? flow[estado.node] : null;

            // ✅ 1. Forma de pagamento (PRIORIDADE)
            if (buttonId && buttonId.startsWith('pagto_')) {
              const forma = buttonId.replace('pagto_', '');
              if (!global._pagamentoEscolhido) global._pagamentoEscolhido = new Map();
              global._pagamentoEscolhido.set(remoteJid, forma);
              console.log(`💳 Forma de pagamento: ${forma}`);
              proximoNo = (forma === 'pix') ? 'confirmar_pedido' : 'finalizar_pedido';
            }

            // ✅ 2. Limpar carrinho
            if (buttonId === 'limpar_carrinho') {
              clearCarrinho(remoteJid);
              clearEscolhasFluxo(remoteJid);
              proximoNo = 'inicio';
            }

            // ✅ 3. Adicionar item ao carrinho
            if (typeof ITENS_MAP !== 'undefined' && ITENS_MAP[buttonId]) {
              const item = ITENS_MAP[buttonId];
              if (item.categoria === 'bairro') {
                setBairroCarrinho(remoteJid, buttonId);
              } else if (item.categoria !== 'tamanho' && item.categoria !== 'borda') {
                addItemCarrinho(remoteJid, { nome: item.nome, valor: item.valor, qtd: 1 });
              }
            }

            // ✅ 4. Salvar escolha
            const esc = extrairEscolha(buttonId);
            if (esc) {
              setEscolhaFluxo(remoteJid, esc.chave, esc.valor);
            }

            // ✅ 5. Se ainda não tem próximo, buscar no CATÁLOGO dinâmico
            if (!proximoNo) {
              try {
                const card = loadCardapio();
                for (const cat of (card.categorias || [])) {
                  const item = (cat.itens || []).find(i => i.id === buttonId);
                  if (item && item.next) {
                    proximoNo = item.next;
                    console.log(`📋 [${name}] next do catálogo: ${buttonId} -> ${item.next}`);
                    break;
                  }
                }
              } catch (e) { console.warn('Erro busca catálogo:', e.message); }
            }

            // ✅ 6. Buscar em noAtual.buttons
            if (!proximoNo && noAtual && noAtual.buttons) {
              const botaoClicado = noAtual.buttons.find(b => b.id === buttonId);
              if (botaoClicado && botaoClicado.next) proximoNo = botaoClicado.next;
            }

            // ✅ 7. Buscar em noAtual.list
            if (!proximoNo && noAtual && noAtual.list && noAtual.list.sections) {
              for (const sec of noAtual.list.sections) {
                const row = (sec.rows || []).find(r => r.id === buttonId);
                if (row && row.next) { proximoNo = row.next; break; }
              }
            }

            // ✅ 8. Fallback: varrer todos os nós
            if (!proximoNo) {
              for (const [nodeName, node] of Object.entries(flow)) {
                if (node.buttons) {
                  const btn = node.buttons.find(b => b.id === buttonId);
                  if (btn && btn.next) { proximoNo = btn.next; break; }
                }
                if (node.list && node.list.sections) {
                  for (const sec of node.list.sections) {
                    const row = (sec.rows || []).find(r => r.id === buttonId);
                    if (row && row.next) { proximoNo = row.next; break; }
                  }
                  if (proximoNo) break;
                }
              }
            }
          }

          if (proximoNo && flow[proximoNo]) {
            const no = flow[proximoNo];
            setFluxoEstado(remoteJid, fluxoCfg.flow || 'padrao', proximoNo);
            console.log(`🔀 [${name}] Fluxo -> ${proximoNo}`);
            
            // ============================================================
            // SE O NO TEM PAGAMENTO PIX, GERAR O PIX
            // ============================================================
            // ============================================================
            // NÓ DINÂMICO — cria pedido + gera PIX com valor calculado
            // ============================================================
            // ============================================================
            // NÓ DINÂMICO — escolher forma de pagamento
            // ============================================================
            if (no.dynamic === 'escolher_pagamento') {
              try {
                const cart = getCarrinho(remoteJid);
                if (cart.itens.length === 0) {
                  await sock.sendMessage(remoteJid, { text: '🛒 Carrinho vazio!' });
                  continue;
                }
                const formas = getFormasAtivas(name);
                if (formas.length === 0) {
                  await sock.sendMessage(remoteJid, { text: '⚠️ Nenhuma forma de pagamento configurada. Fale com o atendente.' });
                  continue;
                }
                const itensTxt = cart.itens.map(i => '• ' + i.qtd + 'x ' + i.nome + ' — R$ ' + (i.valor * i.qtd).toFixed(2)).join('\n');
                const bairroInfo = ITENS_MAP[cart.bairro] || { nome: 'Centro', valor: 5 };
                const total = cart.subtotal + bairroInfo.valor;

                const texto =
                  '💳 *Escolha a forma de pagamento:*\n\n' +
                  '*Resumo do pedido:*\n' + itensTxt + '\n\n' +
                  'Subtotal: R$ ' + cart.subtotal.toFixed(2).replace('.', ',') + '\n' +
                  'Taxa entrega: R$ ' + bairroInfo.valor.toFixed(2).replace('.', ',') + '\n' +
                  '*TOTAL: R$ ' + total.toFixed(2).replace('.', ',') + '*';

                // Montar botões (máx 3)
                const botoes = formas.slice(0, 3).map(f => ({
                  id: 'pagto_' + f.id,
                  text: f.label
                }));

                await sock.sendMessage(remoteJid, { text: texto });
                await new Promise(r => setTimeout(r, 500));
                await sendButtons(sock, remoteJid, {
                  title: '💰 Formas de Pagamento',
                  text: 'Como deseja pagar?',
                  footer: 'Escolha uma opção abaixo',
                  buttons: botoes
                });
                console.log(`💳 [${name}] Formas de pagamento enviadas: ${formas.map(f => f.id).join(', ')}`);
              } catch (e) {
                console.error(`❌ [${name}] Erro escolher_pagamento:`, e.message);
              }
              continue;
            }

            // ============================================================
            // FINALIZAR PEDIDO (dinheiro/cartão — sem PIX)
            // ============================================================
            if (no.dynamic === 'finalizar_pedido' || no.dynamic === 'criar_pedido_sem_pix') {
              try {
                const cart = getCarrinho(remoteJid);
                if (cart.itens.length === 0) {
                  await sock.sendMessage(remoteJid, { text: '🛒 Carrinho vazio!' });
                  continue;
                }
                const forma = (global._pagamentoEscolhido && global._pagamentoEscolhido.get(remoteJid)) || 'dinheiro';
                const pedido = await criarPedidoDoCarrinho(name, remoteJid, msg.pushName, cart, forma);
                if (!pedido) {
                  await sock.sendMessage(remoteJid, { text: '❌ Erro ao processar pedido.' });
                  continue;
                }
                const itensTxt = pedido.itens.map(i => '• ' + i.qtd + 'x ' + i.nome + ' — R$ ' + (i.valor * i.qtd).toFixed(2)).join('\n');
                const formaLabel = { dinheiro: '💵 Dinheiro (na entrega)', cartao_entrega: '💳 Cartão (na entrega)', cartao_online: '💳 Cartão (online)' }[forma] || forma;
                const texto =
                  '✅ *Pedido ' + pedido.id + ' confirmado!*\n\n' +
                  itensTxt + '\n\n' +
                  'Subtotal: R$ ' + pedido.subtotal.toFixed(2).replace('.', ',') + '\n' +
                  'Taxa entrega: R$ ' + pedido.taxaEntrega.toFixed(2).replace('.', ',') + '\n' +
                  '*TOTAL: R$ ' + pedido.total.toFixed(2).replace('.', ',') + '*\n\n' +
                  '💰 Pagamento: ' + formaLabel + '\n' +
                  '📍 ' + pedido.endereco + '\n\n' +
                  '⏱️ *Previsão: 40-50 minutos*\n' +
                  '📦 Acompanhe enviando: *STATUS ' + pedido.id + '*';
                await sock.sendMessage(remoteJid, { text: texto });
                console.log(`✅ [${name}] Pedido ${pedido.id} finalizado (${forma})`);
                if (global._pagamentoEscolhido) global._pagamentoEscolhido.delete(remoteJid);
              } catch (e) {
                console.error(`❌ [${name}] Erro finalizar:`, e.message);
              }
              continue;
            }

            if (no.dynamic === 'criar_pedido') {
              try {
                console.log(`🛒 [${name}] Nó dinâmico: criar_pedido`);

                // 1. Recuperar escolhas do estado do fluxo
                const estadoAtual = getFluxoEstado(remoteJid);
                const escolhas = getEscolhasFluxo(remoteJid) || {};

                console.log(`🛒 [${name}] Escolhas:`, JSON.stringify(escolhas));

                // 2. Criar pedido
                // ✅ Usar CARRINHO em vez de escolhas
                const cart = getCarrinho(remoteJid);
                console.log(`🛒 [${name}] Carrinho tem ${cart.itens.length} itens — Subtotal R$ ${cart.subtotal.toFixed(2)}`);

                if (cart.itens.length === 0) {
                  await sock.sendMessage(remoteJid, { text: '🛒 Seu carrinho está vazio! Adicione itens antes de fechar o pedido.' });
                  continue;
                }

                const pedido = await criarPedidoDoCarrinho(name, remoteJid, msg.pushName, cart);
                if (!pedido) {
                  await sock.sendMessage(remoteJid, { text: '❌ Erro ao processar pedido. Fale com um atendente.' });
                  continue;
                }

                // 3. Montar texto do pedido
                const itensTxt = pedido.itens.map(i => '• ' + i.qtd + 'x ' + i.nome + ' — R$ ' + (i.valor * i.qtd).toFixed(2)).join('\n');
                const textoPedido =
                  '✅ *Pedido ' + pedido.id + ' confirmado!*\n\n' +
                  '👤 ' + (pedido.cliente.nome || 'Cliente') + '\n' +
                  '📍 ' + pedido.endereco + '\n\n' +
                  '*Itens:*\n' + itensTxt + '\n\n' +
                  'Subtotal: R$ ' + pedido.subtotal.toFixed(2).replace('.', ',') + '\n' +
                  'Taxa entrega: R$ ' + pedido.taxaEntrega.toFixed(2).replace('.', ',') + '\n' +
                  '*TOTAL: R$ ' + pedido.total.toFixed(2).replace('.', ',') + '*\n\n' +
                  '⏱️ *Previsão: 40-50 minutos*\n' +
                  '📦 Acompanhe enviando: *STATUS ' + pedido.id + '*\n\n' +
                  '💰 Gerando PIX...';

                await sock.sendMessage(remoteJid, { text: textoPedido });
                await new Promise(r => setTimeout(r, 1500));

                // 4. Gerar PIX com valor calculado
                try {
                  const pix = await criarPix(name, remoteJid, pedido.total, 'Pedido ' + pedido.id);
                  const valorFormatado = 'R$ ' + pedido.total.toFixed(2).replace('.', ',');

                  const textoInstrucoes =
                    '💰 *Pagamento PIX*\n\n' +
                    '*Valor:* ' + valorFormatado + '\n\n' +
                    '👇 *Escaneie o QR Code abaixo* com o app do seu banco.';

                  await sock.sendMessage(remoteJid, { text: textoInstrucoes });
                  await new Promise(r => setTimeout(r, 1000));

                  const qrBuffer = Buffer.from(pix.qrCodeBase64, 'base64');
                  await sock.sendMessage(remoteJid, {
                    image: qrBuffer,
                    caption: '📱 QR Code PIX — ' + valorFormatado
                  });
                  await new Promise(r => setTimeout(r, 1500));
                  await sock.sendMessage(remoteJid, { text: pix.qrCode });

                  console.log(`✅ [${name}] Pedido ${pedido.id} + PIX enviados`);
                  clearEscolhasFluxo(remoteJid);
                } catch (e) {
                  console.error(`❌ [${name}] Erro PIX:`, e.message);
                  await sock.sendMessage(remoteJid, { text: 'Erro ao gerar PIX. Fale com atendente.' });
                }
              } catch (e) {
                console.error(`❌ [${name}] Erro criar_pedido:`, e.message);
              }
              continue;
            }

            // ============================================================
            // NÓ COM LISTA NATIVA (catálogo simplificado)
            // ============================================================
            // ============================================================
            // LISTA DINÂMICA (lê do cardapio.json) — PRIORIDADE
            // ============================================================
            if (no.listFromCatalogo) {
              try {
                const card = loadCardapio();
                const sections = (card.categorias || []).map(cat => ({
                  title: (cat.titulo || '').substring(0, 24),
                  rows: (cat.itens || []).map(item => ({
                    id: item.id,
                    title: (item.titulo || '').substring(0, 24),
                    description: (item.descricao || '').substring(0, 72),
                    next: item.next
                  }))
                })).filter(s => s.rows.length > 0);

                let totalItens = 0;
                const sectionsLimitadas = [];
                for (const s of sections) {
                  if (totalItens >= 10) break;
                  const rows = s.rows.slice(0, 10 - totalItens);
                  sectionsLimitadas.push({ title: s.title, rows });
                  totalItens += rows.length;
                }

                console.log(`📋 [${name}] Lista DINÂMICA do catálogo: ${totalItens} itens em ${sectionsLimitadas.length} seções`);

                await sendInteractiveMessage(sock, remoteJid, {
                  text: no.text || 'Escolha:',
                  footer: no.footer || '',
                  interactiveButtons: [{
                    name: 'single_select',
                    buttonParamsJson: JSON.stringify({
                      title: no.listButtonText || 'Ver Catálogo 📂',
                      sections: sectionsLimitadas
                    })
                  }]
                });
                console.log(`✅ [${name}] Lista dinâmica enviada`);
              } catch (e) {
                console.error(`❌ [${name}] Erro lista dinâmica:`, e.message);
                await sock.sendMessage(remoteJid, { text: no.text || 'Erro ao carregar catálogo.' });
              }
              continue;
            }

            if (no.list && no.list.sections) {
              try {
                console.log(`📋 [${name}] Enviando lista nativa: ${no.title || ''}`);
                await sendInteractiveMessage(sock, remoteJid, {
                  text: no.text || '',
                  footer: no.footer || '',
                  interactiveButtons: [{
                    name: 'single_select',
                    buttonParamsJson: JSON.stringify({
                      title: no.list.buttonText || 'Ver Opções',
                      sections: no.list.sections
                    })
                  }]
                });
                saveConversa(remoteJid, name, msg.pushName || 'Cliente', no.text || '', 'enviada');
                console.log(`✅ [${name}] Lista nativa enviada`);
              } catch (e) {
                console.error(`❌ [${name}] Erro lista:`, e.message);
                await sock.sendMessage(remoteJid, { text: no.text || '' });
              }
              continue;
            }

            if (no.pix && no.pix.amount) {
              try {
                console.log('💰 [${name}] Gerando PIX de R$ ' + no.pix.amount);
                const pix = await criarPix(name, remoteJid, no.pix.amount, no.pix.description || no.title);
                
                const valorFormatado = 'R$ ' + parseFloat(no.pix.amount).toFixed(2).replace('.', ',');
                
                // ============================================================
                // MENSAGEM 1: Texto com instrucoes + QR Code
                // ============================================================
                const textoInstrucoes = 
                  '💰 *Pagamento PIX*\n\n' +
                  (no.text ? no.text + '\n\n' : '') +
                  '*Valor:* ' + valorFormatado + '\n\n' +
                  '👇 *Escaneie o QR Code abaixo* com o app do seu banco.';
                
                try {
                  // Enviar texto primeiro
                  await sock.sendMessage(remoteJid, { text: textoInstrucoes });
                  await new Promise(r => setTimeout(r, 1000));
                  
                  // Depois enviar o QR Code
                  const qrBuffer = Buffer.from(pix.qrCodeBase64, 'base64');
                  await sock.sendMessage(remoteJid, {
                    image: qrBuffer,
                    caption: '📱 QR Code PIX — ' + valorFormatado
                  });
                } catch (e) {
                  console.error('Erro ao enviar QR:', e.message);
                }
                
                // ============================================================
                // MENSAGEM 2: Codigo Copia e Cola (texto separado)
                // ============================================================
                await new Promise(r => setTimeout(r, 1500));
                
                try {
                await sock.sendMessage(remoteJid, { text: pix.qrCode });
                } catch (e) {
                  console.error('Erro ao enviar copia e cola:', e.message);
                }
                
                console.log('✅ [${name}] PIX enviado para ' + remoteJid);
              } catch (e) {
                console.error('❌ [${name}] Erro ao gerar PIX:', e.message);
                await sock.sendMessage(remoteJid, { 
                  text: 'Erro ao gerar o PIX. Tente novamente ou fale com um atendente.'
                });
              }
              continue;
            }
            
            try {
              await sendButtons(sock, remoteJid, {
                title: no.title || '',
                text: no.text || '',
                footer: no.footer || '',
                buttons: (no.buttons || []).map(b => ({ id: b.id, text: b.text }))
              });
              saveConversa(remoteJid, name, msg.pushName || 'Cliente', no.text || '', 'enviada');
              console.log(`✅ [${name}] Nó "${proximoNo}" enviado`);
            } catch (e) {
              console.error(`❌ [${name}] Erro:`, e.message);
              await sock.sendMessage(remoteJid, { text: no.text || '' });
            }
          }
          continue; // Fluxo tratou, não passa para o bot IA
        }
      }

      // ============================================================
      // 3. BOT IA (Groq) — fallback quando fluxo desativado
      // ============================================================
      const config = botConfigs.get(name);

      // ✅ REGRA: IA só responde se tiver AGENTE ATRIBUÍDO
      if (!promptAgente) {
        console.log(`🔇 [${name}] Sem agente atribuido — IA nao responde`);
        continue;
      }

      const promptFinal = promptAgente;
      console.log(`🤖 [${name}] Usando prompt: Agente atribuido`);

      if (isButtonClick) {
        const mapBotoes = {
          'ver_precos': 'Quero ver os preços dos serviços.',
          'orcamento': 'Quero solicitar um orçamento.',
          'atendente': 'Quero falar com um atendente humano.',
          'horario': 'Qual o horário de funcionamento?',
          'endereco': 'Qual o endereço e contato?'
        };
        textMessage = mapBotoes[buttonId] || `O cliente clicou: ${buttonId}`;
      }

      const textoLower = textMessage.toLowerCase().trim();
      const ehSaudacao = !isButtonClick && /^(oi|ola|ol[aá]|bom dia|boa tarde|boa noite|eai|e ai|opa|hey|hi|hello|menu|op[cç][oõ]es|iniciar|start|voltar|tudo bem|tudo bom|td bem|td bom|blz|beleza)[\s!.,?]*/i.test(textoLower);

      try {
        const groqClient = getGroqClient(name);
        if (!groqClient) {
          console.error(`❌ [${name}] Groq client não disponível`);
          continue;
        }

        if (!botMemory.has(remoteJid)) {
          botMemory.set(remoteJid, [{ role: 'system', content: promptFinal }]);
        }
        const history = botMemory.get(remoteJid);
        history.push({ role: 'user', content: textMessage });
        if (history.length > 21) history.splice(1, history.length - 21);

        console.log(`🤖 [${name}] Groq para ${remoteJid}...`);
        const completion = await groqClient.chat.completions.create({
          model: "openai/gpt-oss-120b",
          messages: history,
        });
        const reply = completion.choices[0].message.content;
        history.push({ role: 'assistant', content: reply });

        await sock.presenceSubscribe(remoteJid);
        await sock.sendPresenceUpdate('composing', remoteJid);
        await new Promise(r => setTimeout(r, 1500));
        await sock.sendPresenceUpdate('paused', remoteJid);
        await sock.sendMessage(remoteJid, { text: reply });
        saveConversa(remoteJid, name, msg.pushName || 'Cliente', reply, 'enviada');
        console.log(`✅ [${name}] Resposta enviada`);
      } catch (err) {
        console.error(`❌ [${name}] Erro Groq:`, err.message);
      }
    }
  });
  // --- FIM IA (Groq) ---

  if (phoneNumber) {
    setTimeout(async () => {
      try {
        const cleanNumber = phoneNumber.replace(/\D/g, '');
        console.log(`🔐 [${name}] Gerando código para ${cleanNumber}...`);
        const code = await sock.requestPairingCode(cleanNumber);
        data.pairingCode = code;
        data.status = 'pairing_code';
        data.lastUpdate = new Date().toISOString();
        instances.set(name, data);
        console.log(`✅ [${name}] Código de pareamento: ${code}`);
      } catch (error) {
        console.error(`❌ [${name}] Erro ao gerar código:`, error.message);
        data.status = 'pairing_error';
        data.error = error.message;
        instances.set(name, data);
      }
    }, 3000);
  }

  sock.ev.on('connection.update', async (update) => {
    const { connection, qr, lastDisconnect } = update;
    data.lastUpdate = new Date().toISOString();

    if (qr && !phoneNumber) {
      // Gera data URL: "data:image/png;base64,..."
      data.qr = await QRCode.toDataURL(qr);
      data.status = 'qrcode';
      instances.set(name, data);
      console.log(`📱 [${name}] QR Code atualizado`);
    }

    if (connection === 'open') {
      data.status = 'connected';
      data.qr = null;
      data.pairingCode = null;

      if (sock.user) {
        data.phone = (sock.user.id || '').split(':')[0].split('@')[0];
        data.displayName = sock.user.name || null;
      }

      saveConfig(name, {
        token,
        createdAt: new Date().toISOString(),
        phone: data.phone,
      });

      console.log(`✅ [${name}] WhatsApp conectado!`);
      instances.set(name, data);
    }

    if (connection === 'close') {
      const code = lastDisconnect?.error?.output?.statusCode;

      if (code === DisconnectReason.loggedOut) {
        data.status = 'logged_out';
        data.sock = null;
        console.log(`❌ [${name}] Logout detectado.`);
        instances.set(name, data);
        return;
      }

      data.status = 'reconnecting';
      console.log(`🔄 [${name}] Reconectando...`);
      instances.set(name, data);

      setTimeout(() => {
        startInstance(name, token).catch((err) => {
          console.error(`Erro ao reconectar ${name}:`, err.message);
        });
      }, 3000);
    }
  });

  return data;
}

async function loadSavedInstances() {
  const entries = fs.readdirSync(SESSIONS_DIR, { withFileTypes: true });

  for (const entry of entries) {
    if (!entry.isDirectory()) continue;

    const config = loadConfig(entry.name);
    if (!config?.token) continue;

    try {
      console.log(`🔄 Carregando instância ${entry.name}`);
      await startInstance(entry.name, config.token);
    } catch (error) {
      console.error(`Erro ao carregar ${entry.name}:`, error.message);
    }
  }
}

