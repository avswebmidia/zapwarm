const DONO_WHATSAPP = process.env.DONO_WHATSAPP || '5515998295029';

function calcularTotal(escolhas) {
  const { pizza, tamanho, borda, bebida, bairro, quantidade } = escolhas || {};
  const p = CARDAPIO.pizzas[pizza];
  const t = CARDAPIO.tamanhos[tamanho];
  const b = CARDAPIO.bordas[borda];
  const b2 = CARDAPIO.bebidas[bebida];
  const bairroInfo = CARDAPIO.bairros[bairro];
  if (!p || !t || !b) return null;
  const qtd = parseInt(quantidade) || 1;
  const precoPizza = (p.precoBase + t.ajuste) * qtd;
  const itens = [];
  itens.push({ nome: 'Pizza ' + p.nome + ' ' + t.nome, qtd: qtd, valor: p.precoBase + t.ajuste });
  let subtotal = precoPizza;
  if (b && b.preco > 0) { itens.push({ nome: 'Borda ' + b.nome, qtd: qtd, valor: b.preco }); subtotal += b.preco * qtd; }
  if (b2 && b2.preco > 0) { itens.push({ nome: b2.nome, qtd: 1, valor: b2.preco }); subtotal += b2.preco; }
  const taxaEntrega = bairroInfo ? bairroInfo.taxa : 0;
  return { itens, subtotal, taxaEntrega, total: subtotal + taxaEntrega, bairro: bairroInfo };
}

async function criarPedidoDoFluxo(name, remoteJid, pushName, escolhas, enderecoTexto) {
