app.post('/webhook/mp', async (req, res) => {
  // Responder IMEDIATAMENTE
  res.sendStatus(200);
  
  try {
    const { type, data, action } = req.body;
    console.log('[MP Webhook] Recebido:', JSON.stringify({ type, action, dataId: data?.id }));
    
    if (type !== 'payment' || !data || !data.id) return;
    
    // Encontrar qual instancia é dona desse payment
    const pag = pagamentosPendentes.get(String(data.id));
    if (!pag) {
      console.log('[MP Webhook] Pagamento nao rastreado: ' + data.id);
      return;
    }
    
    // Consultar detalhes do pagamento
    const client = getMpClient(pag.instance);
    if (!client) {
      console.error('[MP Webhook] Cliente MP nao disponivel para ' + pag.instance);
      return;
    }
    
    const payment = new Payment(client);
    const result = await payment.get({ id: data.id });
    
    console.log('[MP Webhook] Status do pagamento ' + data.id + ': ' + result.status);
    
    // ============================================================
    // SE APROVADO: enviar mensagem de confirmacao
    // ============================================================
    if (result.status === 'approved') {
      const inst = instances.get(pag.instance);
      
      if (inst && inst.sock) {
        const valor = 'R$ ' + pag.amount.toFixed(2).replace('.', ',');
        
        // Mensagem de confirmacao
        const mensagem = 
          '✅ *Pagamento Confirmado!*\n\n' +
          'O pagamento de *' + valor + '* foi aprovado com sucesso! 🎉\n\n' +
          'Obrigado pela preferencia. Se precisar de algo, e so chamar!';
        
        try {
          await inst.sock.sendMessage(pag.remoteJid, { text: mensagem });
          console.log('[MP Webhook] Confirmacao enviada para ' + pag.remoteJid);
        } catch (e) {
          console.error('[MP Webhook] Erro ao enviar mensagem:', e.message);
        }
        
        // Se o fluxo estava aguardando esse pagamento, avancar
        const estado = getFluxoEstado(pag.remoteJid);
        if (estado) {
          const flow = carregarFluxo(estado.flow);
          if (flow && flow[estado.node]) {
            const no = flow[estado.node];
            // Se o no atual tem botao "pagamento_ok" ou similar, avancar
            if (no.buttons) {
              const btnAposPix = no.buttons.find(b => b.next === 'pagamento_confirmado' || b.id === 'apos_pagamento');
              if (btnAposPix && btnAposPix.next && flow[btnAposPix.next]) {
                const proximo = flow[btnAposPix.next];
                setFluxoEstado(pag.remoteJid, estado.flow, btnAposPix.next);
                try {
                  await sendButtons(inst.sock, pag.remoteJid, {
                    title: proximo.title || '',
                    text: proximo.text || '',
                    footer: proximo.footer || '',
                    buttons: (proximo.buttons || []).map(b => ({ id: b.id, text: b.text }))
                  });
                } catch (e) {}
              }
            }
          }
        }
      }
      
      // Limpar pagamento processado
      pagamentosPendentes.delete(String(data.id));
    }
  } catch (error) {
    console.error('[MP Webhook] Erro:', error.message);
  }
});

