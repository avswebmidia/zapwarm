// Cache de pagamentos (para associar paymentId -> instância/cliente)
const pagamentosPendentes = new Map();  // paymentId -> { instance, remoteJid, amount, flow, node }

// MercadoPago clients por instância (cache)
const mpClients = new Map();

function getMpClient(instanceName) {
  const config = mpConfigs.get(instanceName);
  if (!config || !config.accessToken) return null;
  
  if (!mpClients.has(config.accessToken)) {
    mpClients.set(config.accessToken, new MercadoPagoConfig({ 
      accessToken: config.accessToken 
    }));
  }
  return mpClients.get(config.accessToken);
}

// ============================================================
// FUNCAO: Criar pagamento PIX
// ============================================================
async function criarPix(instanceName, remoteJid, amount, description) {
  const client = getMpClient(instanceName);
  if (!client) throw new Error('Mercado Pago nao configurado para ' + instanceName);
  
  const payment = new Payment(client);
  
  const body = {
    transaction_amount: parseFloat(amount),
    description: description || 'Pagamento Zapwarm',
    payment_method_id: 'pix',
    payer: {
      email: 'cliente_' + Date.now() + '@zapwarm.com.br'
    },
    external_reference: instanceName + '|' + remoteJid
  };
  
  const result = await payment.create({ body });
  
  // Salvar pagamento pendente para vincular ao webhook
  pagamentosPendentes.set(String(result.id), {
    instance: instanceName,
    remoteJid: remoteJid,
    amount: parseFloat(amount),
    paymentId: result.id,
    createdAt: Date.now()
  });
  
  console.log('PIX criado: ' + result.id + ' para ' + remoteJid + ' (R$ ' + amount + ')');
  
  return {
    paymentId: result.id,
    status: result.status,
    qrCode: result.point_of_interaction.transaction_data.qr_code,
    qrCodeBase64: result.point_of_interaction.transaction_data.qr_code_base64,
    ticketUrl: result.point_of_interaction.transaction_data.ticket_url
  };
}


