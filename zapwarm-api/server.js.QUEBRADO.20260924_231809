const groqClients = new Map();

try {
  if (fs.existsSync(GROQ_KEY_FILE)) {
    const data = JSON.parse(fs.readFileSync(GROQ_KEY_FILE, 'utf8'));
    for (const [k, v] of Object.entries(data)) groqKeys.set(k, v);
    console.log('Groq: ' + groqKeys.size + ' chave(s) carregada(s)');
  }
} catch (e) {}

function saveGroqKeys() {
  try {
    const obj = {};
    for (const [k, v] of groqKeys.entries()) obj[k] = v;
    fs.writeFileSync(GROQ_KEY_FILE, JSON.stringify(obj, null, 2));
  } catch (e) {}
}

function getGroqClientByName(instanceName) {
  let apiKey = groqKeys.get(instanceName);       // 1º: por instância
  if (!apiKey) apiKey = groqGlobal.apiKey;        // 2º: global do painel
  if (!apiKey) apiKey = process.env.GROQ_API_KEY; // 3º: .env
  if (!apiKey) return null;
  if (!groqClients.has(apiKey)) {
    groqClients.set(apiKey, new Groq({ apiKey }));
  }
  return groqClients.get(apiKey);
}

