function getGroqClient(instanceName) {
    // Verificar se as variáveis existem
    if (typeof groqKeys === 'undefined') {
        console.error('[getGroqClient] groqKeys nao definido');
        return null;
    }
    if (typeof groqClients === 'undefined') {
        console.error('[getGroqClient] groqClients nao definido');
        return null;
    }
    
    // 1. Chave específica da instância
    let apiKey = groqKeys.get(instanceName);
    
    // 2. Chave global
    if (!apiKey) apiKey = process.env.GROQ_API_KEY;
    
    // 3. Sem chave
    if (!apiKey) {
        console.warn('[getGroqClient] Sem chave Groq para', instanceName);
        return null;
    }
    
    // Cache do cliente
    if (!groqClients.has(apiKey)) {
        try {
            const GroqLib = require('groq-sdk');
            groqClients.set(apiKey, new GroqLib({ apiKey: apiKey }));
            console.log('[getGroqClient] Novo cliente criado para', instanceName);
        } catch (e) {
            console.error('[getGroqClient] Erro ao criar cliente:', e.message);
            return null;
        }
    }
    
    return groqClients.get(apiKey);
}

