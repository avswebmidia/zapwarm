app.post('/disparo/start', async (req, res) => {
  try {
    const { instance, modo, numeros, mensagem, imageUrl, flowName, delayMin, delayMax } = req.body;
    if (!instance || !Array.isArray(numeros) || numeros.length === 0) {
      return res.status(400).json({ success: false, error: 'instance e numeros obrigatorios' });
    }
    if (!instances.get(instance)) {
      return res.status(404).json({ success: false, error: 'Instancia nao encontrada' });
    }

    // Normaliza números (só dígitos)
    const numerosLimpos = numeros
      .map(n => String(n).replace(/\D/g, ''))
      .filter(n => n.length >= 10);

    const jobId = gerarJobId();
    const job = {
      id: jobId,
      instance,
      modo: modo || 'texto',
      numeros: numerosLimpos,
      total: numerosLimpos.length,
      enviados: 0,
      erros: 0,
      mensagem: mensagem || '',
      imageUrl: imageUrl || '',
      flowName: flowName || 'jefferson',
      delayMin: Math.max(parseInt(delayMin) || 20, 10),
      delayMax: Math.max(parseInt(delayMax) || 30, 15),
      status: 'iniciando',
      log: [],
      iniciadoEm: new Date().toISOString()
    };
    disparoJobs.set(jobId, job);
    console.log(`📢 Disparo ${jobId} iniciado: ${job.total} números (modo: ${job.modo})`);

    // Processa em background
    processarDisparo(jobId).catch(e => console.error('Erro processarDisparo:', e.message));

    res.json({ success: true, jobId, total: job.total });
  } catch (e) { res.status(500).json({ success: false, error: e.message }); }
});

