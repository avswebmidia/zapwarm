const disparoJobs = new Map();  // jobId -> { status, total, enviados, erros, fila, ... }

function gerarJobId() {
  return 'job_' + Date.now() + '_' + Math.random().toString(36).substring(2, 8);
}

// Detecta opt-out automático nas respostas
const PALAVRAS_OPTOUT = ['sair', 'parar', 'stop', 'cancelar', 'remover', 'descadastrar', 'nao quero', 'não quero'];

async function processarDisparo(jobId) {
  const job = disparoJobs.get(jobId);
  if (!job || job.status === 'cancelado') return;

  job.status = 'rodando';

  for (let i = job.enviados + job.erros; i < job.numeros.length; i++) {
    const currentJob = disparoJobs.get(jobId);
    if (!currentJob || currentJob.status === 'cancelado') {
      console.log(`⏹️  Disparo ${jobId} cancelado`);
      return;
    }
    if (currentJob.status === 'pausado') {
      console.log(`⏸️  Disparo ${jobId} pausado`);
      return;
    }

    const telefone = job.numeros[i];
    const jid = telefone + '@s.whatsapp.net';

    // ✅ Verifica opt-in
    if (!temOptin(telefone)) {
      job.erros++;
      job.log.push({ telefone, status: 'sem_optin', em: new Date().toISOString() });
      console.log(`⏭️  ${telefone} — sem opt-in, pulado`);
      continue;
    }
    if (temOptout(telefone)) {
      job.erros++;
      job.log.push({ telefone, status: 'optout', em: new Date().toISOString() });
      console.log(`⏭️  ${telefone} — opt-out, pulado`);
      continue;
    }

    try {
      const inst = instances.get(job.instance);
      if (!inst || !inst.sock) {
        job.erros++;
        job.log.push({ telefone, status: 'sem_instancia', em: new Date().toISOString() });
        continue;
      }

      // Modo do disparo
      if (job.modo === 'fluxo') {
        // Dispara o primeiro nó do fluxo ativo
        const flow = carregarFluxo(job.flowName || 'jefferson');
        const noInicio = flow && (flow.inicio || Object.values(flow)[0]);
        if (!noInicio) throw new Error('Fluxo sem nó inicial');

        if (noInicio.list && noInicio.list.sections) {
          await sendInteractiveMessage(inst.sock, jid, {
            text: noInicio.text || '',
            footer: noInicio.footer || '',
            interactiveButtons: [{
              name: 'single_select',
              buttonParamsJson: JSON.stringify({
                title: noInicio.listButtonText || 'Ver Opções',
                sections: noInicio.list.sections
              })
            }]
          });
        } else if (noInicio.buttons && noInicio.buttons.length > 0) {
          await sendButtons(inst.sock, jid, {
            title: noInicio.title || '',
            text: noInicio.text || '',
            footer: noInicio.footer || '',
            buttons: noInicio.buttons.map(b => ({ id: b.id, text: b.text }))
          });
        } else {
          await inst.sock.sendMessage(jid, { text: noInicio.text || '' });
        }
      } else if (job.modo === 'imagem') {
        if (job.imageUrl) {
          await inst.sock.sendMessage(jid, {
            image: { url: job.imageUrl },
            caption: job.mensagem || ''
          });
        } else {
          await inst.sock.sendMessage(jid, { text: job.mensagem || '' });
        }
      } else {
        await inst.sock.sendMessage(jid, { text: job.mensagem || '' });
      }

      job.enviados++;
      job.log.push({ telefone, status: 'ok', em: new Date().toISOString() });
      console.log(`✅ [${job.enviados}/${job.total}] ${telefone}`);

      // Delay aleatório
      const delay = job.delayMin + Math.random() * (job.delayMax - job.delayMin);
      await new Promise(r => setTimeout(r, delay * 1000));

    } catch (e) {
      job.erros++;
      job.log.push({ telefone, status: 'erro', erro: e.message, em: new Date().toISOString() });
      console.error(`❌ ${telefone}: ${e.message}`);
    }
  }

  job.status = 'concluido';
  job.fim = new Date().toISOString();
  console.log(`✅ Disparo ${jobId} concluído: ${job.enviados} ok, ${job.erros} erros`);
}



