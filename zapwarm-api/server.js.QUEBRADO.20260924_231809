    // ✅ Busca o agente
    const agente = agentesStore.agentes[agenteId];

    if (!agente) {
      console.error('[atribuir] ❌ Agente NAO ENCONTRADO. ID:', agenteId);
      console.error('[atribuir] IDs disponiveis:', Object.keys(agentesStore.agentes));
      return res.status(404).json({
        success: false,
        error: 'Agente nao encontrado',
        agenteId,
        disponiveis: Object.keys(agentesStore.agentes)
      });
    }

    // ✅ Atribui
    agentesStore.atribuicoes[instanceName] = agenteId;
    fs.writeFileSync(AGENTES_FILE, JSON.stringify(agentesStore, null, 2));

    console.log('[atribuir] ✅ Atribuido:', agente.nome, '->', instanceName);

    res.json({
      success: true,
      message: 'Agente atribuido com sucesso',
      instanceName,
      agenteId,
      agente: agente.nome
    });
  } catch (e) {
