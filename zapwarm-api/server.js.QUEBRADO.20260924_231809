// EXTRAI ESCOLHA DO BOTÃO/LISTA (pizza_calabresa → {chave:'pizza', valor:'calabresa'})
// ============================================================
function extrairEscolha(buttonId) {
  if (!buttonId || typeof buttonId !== 'string') return null;
  const prefixos = ['pizza', 'tam', 'tamanho', 'borda', 'bebida', 'bairro', 'sabor'];
  for (const p of prefixos) {
    if (buttonId.startsWith(p + '_')) {
      let valor = buttonId.slice(p.length + 1);
      // Normalizar chave
      let chave = p;
      if (p === 'tam') chave = 'tamanho';
      if (p === 'sabor') chave = 'pizza';
      // Normalizar valores especiais
      if (chave === 'tamanho') {
        if (valor === 'media') valor = 'media';
        if (valor === 'grande') valor = 'grande';
        if (valor === 'familia') valor = 'familia';
      }
      return { chave, valor };
    }
  }
  return null;
}

