      const inst = instances.get(pedido.instance);
      if (inst && inst.sock) {
        let texto = mensagemCustom;
        if (!texto) {
          const tpl = STATUS_TEMPLATES[status] || '';
          texto = tpl
            .replace(/{id}/g, pedido.id)
            .replace(/{nome}/g, pedido.cliente.nome || 'Cliente');
