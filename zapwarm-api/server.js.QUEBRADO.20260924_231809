// POST /auth/verify - Verifica a Global API Key
app.post('/auth/verify', (req, res) => {
  try {
    const { apiKey } = req.body;
    
    if (!apiKey) {
      return res.status(400).json({ success: false, error: 'API Key obrigatória' });
    }
    
    const GLOBAL_KEY = process.env.AUTHENTICATION_API_KEY || 'ZapWarm@Segura2026MasterKey';
    
    if (apiKey === GLOBAL_KEY) {
      console.log(`🔓 [AUTH] Login autorizado de ${req.ip || 'unknown'}`);

      // ============================================================
      // CRIAR COOKIE PARA PERSISTIR A AUTENTICAÇÃO ENTRE PÁGINAS
      // ============================================================
      const cookieOptions = [
        `zapwarm_key=${encodeURIComponent(GLOBAL_KEY)}`,
        'Max-Age=' + (30 * 24 * 60 * 60), // 30 dias
        'Path=/',
        'SameSite=Lax'
      ];
