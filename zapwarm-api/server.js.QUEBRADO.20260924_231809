function montarRespostaStatus(pedido) {
  const STATUS_EMOJI = {
    recebido: '📥 Recebido',
    em_preparo: '👨‍🍳 Em preparo',
    saiu_entrega: '🛵 Saiu para entrega',
    entregue: '✅ Entregue',
    cancelado: '❌ Cancelado'
  };
  const dt = (iso) => {
    if (!iso) return '-';
    const d = new Date(iso);
    return d.toLocaleDateString('pt-BR') + ' às ' + d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  };
  const itens = (pedido.itens || []).map(i => '• ' + i.qtd + 'x ' + i.nome).join('\n');
  const ultimo = (pedido.historico || []).slice(-1)[0] || {};
  const pgStatus = pedido.pagamento?.status === 'pago' ? '✅ Pago' : '⏳ Pendente';

  let tempoEstimado = '';
  if (pedido.status === 'recebido') tempoEstimado = 'Previsão: 40-50 min';
  else if (pedido.status === 'em_preparo') tempoEstimado = 'Previsão: 25-35 min';
  else if (pedido.status === 'saiu_entrega') tempoEstimado = 'Previsão: 10-20 min';
  else if (pedido.status === 'entregue') tempoEstimado = 'Entregue em ' + dt(ultimo.em);

  return (
    '📦 *Pedido ' + pedido.id + '*\n\n' +
    '*Status:* ' + (STATUS_EMOJI[pedido.status] || pedido.status) + '\n' +
    '*Atualizado:* ' + dt(ultimo.em) + '\n' +
    (tempoEstimado ? tempoEstimado + '\n' : '') +
    '\n*Itens:*\n' + itens + '\n\n' +
    '*Total:* R$ ' + (pedido.total || 0).toFixed(2).replace('.', ',') + '\n' +
    '*Pagamento:* ' + pgStatus + '\n' +
    '*Endereço:* ' + (pedido.endereco || '-')
  );
}

async function consultarStatusPedido(name, remoteJid, textoMensagem) {
  const telefone = remoteJid.replace(/@.*$/, '');
  const textoUpper = textoMensagem.toUpperCase();

  // 1. Se tem PED-XXXX, busca específico
  const match = textoUpper.match(/PED[-\s]?(\d{1,6})/);
  if (match) {
    const id = 'PED-' + match[1].padStart(4, '0');
    const d = loadPedidos();
    const pedido = d.pedidos[id];
    if (!pedido) {
      return '❌ Pedido *' + id + '* não encontrado.\n\nConfira o número e tente novamente.';
    }
    if (pedido.cliente?.telefone && pedido.cliente.telefone !== telefone) {
      return '❌ Você não tem permissão para consultar esse pedido.';
    }
    return montarRespostaStatus(pedido);
  }

  // 2. Sem ID: lista TODOS os pedidos do cliente (abertos + últimos entregues)
  const d = loadPedidos();
  const meus = Object.values(d.pedidos).filter(p => p.cliente?.telefone === telefone);

  if (meus.length === 0) {
    return '📭 Você ainda não tem pedidos.\n\nEnvie *MENU* para ver o cardápio!';
  }

  // Ordena: abertos primeiro, depois por data
  const abertos = meus.filter(p => p.status !== 'entregue' && p.status !== 'cancelado');
  const fechados = meus.filter(p => p.status === 'entregue' || p.status === 'cancelado').slice(0, 3);
  const lista = [...abertos, ...fechados];

  const STATUS_EMOJI = {
    recebido: '📥 Recebido',
    em_preparo: '👨‍🍳 Em preparo',
    saiu_entrega: '🛵 Saiu para entrega',
    entregue: '✅ Entregue',
    cancelado: '❌ Cancelado'
  };

  const blocos = lista.map(p => {
    const itens = (p.itens || []).map(i => '• ' + i.qtd + 'x ' + i.nome).join('\n');
    const pgStatus = p.pagamento?.status === 'pago' ? '✅ Pago' : '⏳ Pendente';

    let previsao = '';
    if (p.status === 'recebido') previsao = '\n⏱️ Previsão: 40-50 min';
    else if (p.status === 'em_preparo') previsao = '\n⏱️ Previsão: 25-35 min';
    else if (p.status === 'saiu_entrega') previsao = '\n⏱️ Previsão: 10-20 min';

    const abertura = abertos.includes(p) ? '🔥 ' : '';
    return (
      abertura + '*' + p.id + '* — ' + (STATUS_EMOJI[p.status] || p.status) + '\n' +
      itens + '\n' +
      'Total: R$ ' + (p.total || 0).toFixed(2).replace('.', ',') + ' | ' + pgStatus +
      previsao
    );
  }).join('\n\n━━━━━━━━━━━━━━━\n\n');

  const abertosTxt = abertos.length > 0
    ? '📦 *Seus pedidos abertos (' + abertos.length + '):*'
    : '📦 *Seus últimos pedidos:*';

  return abertosTxt + '\n\n' + blocos + '\n\n💡 Envie *MENU* para fazer um novo pedido!';
}



