      conversas[chave] = {
        instance: instance,
        remoteJid: remoteJid,
        nome: nomeCliente || 'Desconhecido',
        primeiraInteracao: new Date().toISOString(),
        ultimaInteracao: new Date().toISOString(),
        totalMensagens: 0,
