    }
    
    conversas[chave].ultimaInteracao = new Date().toISOString();
    conversas[chave].totalMensagens++;
    conversas[chave].mensagens.push({
      tipo: tipo,  // 'recebida' ou 'enviada'
      texto: mensagem,
      timestamp: new Date().toISOString()
    });
    
    // Manter apenas as últimas 100 mensagens
    if (conversas[chave].mensagens.length > 100) {
      conversas[chave].mensagens = conversas[chave].mensagens.slice(-100);
    }
    
    fs.writeFileSync(CONVERSAS_FILE, JSON.stringify(conversas, null, 2));
    return true;
